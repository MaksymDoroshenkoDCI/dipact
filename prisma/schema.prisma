generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model CandidateApplication {
  id            String   @id @default(cuid())
  name          String
  phone         String
  email         String
  location      String
  hasExperience Boolean
  workModel     String
  message       String?
  createdAt     DateTime @default(now())
}

model CompanyRequest {
  id            String   @id @default(cuid())
  company       String
  contactPerson String
  email         String
  phone         String
  region        String
  startDate     String
  message       String?
  createdAt     DateTime @default(now())
}

model ContactMessage {
  id              String   @id @default(cuid())
  name            String
  email           String
  phone           String?
  subject         String
  message         String
  privacyAccepted Boolean? @default(false)
  createdAt       DateTime @default(now())
}
